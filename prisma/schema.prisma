generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        Int           @id @default(autoincrement())
  email     String        @unique
  password  String
  createdAt DateTime      @default(now())
  sessions  SessionUser[]
  stickies  Sticky[]
  votes     Vote[]
}

model Session {
  id           Int           @id @default(autoincrement())
  joinCode     String        @unique // join code
  createdAt    DateTime      @default(now())
  board        Board?
  participants SessionUser[]
}

model SessionUser {
  id        Int     @id @default(autoincrement())
  user      User    @relation(fields: [userId], references: [id])
  userId    Int
  session   Session @relation(fields: [sessionId], references: [id])
  sessionId Int

  joinedAt DateTime @default(now())

  @@unique([userId, sessionId]) // A user can join a session only once
}

model Board {
  id        Int      @id @default(autoincrement())
  name      String
  session   Session  @relation(fields: [sessionId], references: [id])
  sessionId Int      @unique
  stickies  Sticky[]
}

model Sticky {
  id        Int      @id @default(autoincrement())
  board     Board    @relation(fields: [boardId], references: [id])
  boardId   Int
  author    User     @relation(fields: [authorId], references: [id])
  authorId  Int
  content   String
  createdAt DateTime @default(now())
  votes     Vote[]
}

model Vote {
  id        Int      @id @default(autoincrement())
  sticky    Sticky   @relation(fields: [stickyId], references: [id])
  stickyId  Int
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  value     Int // +1 for upvote, -1 for downvote
  createdAt DateTime @default(now())

  @@unique([stickyId, userId]) // one vote per user per sticky
}
